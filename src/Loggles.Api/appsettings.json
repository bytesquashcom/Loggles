{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://+:5000",
  "Storage": {
    "Provider": "sqlite",
    "ConnectionString": "Data Source=logs.db"
  },
  "Retention": {
    "Hours": 48,
    "PurgeIntervalMinutes": 15
  },
  "Mcp": {
    "Enabled": true,
    "Transport": "http",
    "OAuthEnabled": true
  },
  "Auth": {
    "ApiKey": ""
  },
  "Cors": {
    "AllowedOrigins": "*"
  },
  "SelfDiagnostics": {
    "Enabled": false,
    "OtlpEndpoint": "http://localhost:5000"
  }
}
